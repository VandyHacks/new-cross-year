# --- Site ---
# Public production URL (no trailing slash). Used for metadata, the sitemap,
# and admin sign-in links. Leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Search engines are told not to index the site unless this is "true".
# Leave unset until launch, then set it in production and redeploy.
ALLOW_INDEXING=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications via Zoho SMTP (optional) ---
# Judge/sponsor notifications to NOTIFY_EMAIL_TO are skipped unless SMTP_USER
# and SMTP_PASS are set (submitters never get an email). Use a Zoho app-specific password, never the mailbox password.
# Host: smtppro.zoho.com for domain (organization) mailboxes, smtp.zoho.com
# for personal @zohomail.com ones; port 465 = SSL. Supabase Auth reads the same
# SMTP_HOST/USER/PASS at `supabase config push` time.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=hello@vandyhacks.org
SMTP_PASS=
# Optional display name/address; must be SMTP_USER itself or one of its
# verified Zoho aliases. Defaults to "VandyHacks <SMTP_USER>".
EMAIL_FROM="VandyHacks <hello@vandyhacks.org>"
# Where judge/sponsor notifications go.
NOTIFY_EMAIL_TO=info@vandyhacks.org

# --- Spam protection ---
# Any long random string; used to hash IPs for rate limiting. Required in
# production (without it the stored hashes are reversible).
IP_HASH_SALT=
# Header holding the real client IP, set by your edge. Only set this when
# EVERY request passes through that edge (e.g. `cf-connecting-ip` with the
# Cloudflare proxy on); otherwise clients can spoof it. Leave empty on plain
# Vercel/Netlify, which set trusted headers themselves.
CLIENT_IP_HEADER=
# Cloudflare Turnstile (optional; both keys enable the widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
