# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications via Resend (optional) ---
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM="VandyHacks <hello@vandyhacks.org>"
# Where judge/sponsor notifications go.
NOTIFY_EMAIL_TO=info@vandyhacks.org

# --- Spam protection ---
# Any long random string; used to hash IPs for rate limiting.
IP_HASH_SALT=
# Cloudflare Turnstile (optional; both keys enable the widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
