# --- Site ---
# Public production URL (no trailing slash). Used for metadata, the sitemap,
# and admin sign-in links. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications via Resend (optional) ---
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM="VandyHacks <hello@vandyhacks.org>"
# Where judge/sponsor notifications go.
NOTIFY_EMAIL_TO=info@vandyhacks.org

# --- Spam protection ---
# Any long random string; used to hash IPs for rate limiting. Required in
# production (without it the stored hashes are reversible).
IP_HASH_SALT=
# Header holding the real client IP, set by your edge. Only set this when
# EVERY request passes through that edge (e.g. `cf-connecting-ip` with the
# Cloudflare proxy on); otherwise clients can spoof it. Leave empty on plain
# Vercel/Netlify, which set trusted headers themselves.
CLIENT_IP_HEADER=
# Cloudflare Turnstile (optional; both keys enable the widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
